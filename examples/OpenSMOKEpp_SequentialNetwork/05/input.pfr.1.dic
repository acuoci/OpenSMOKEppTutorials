Dictionary PlugFlowReactor
{
		@KineticsFolder			dummy;
		
		@Type					Isothermal;
		
		@InletStatus          	inlet-mixture;
		
		@ResidenceTime			20 ms;
		@Velocity				1 cm/s;
		
		@ConstantPressure		true;
		
}

Dictionary inlet-mixture
{
		@Temperature   	950.  	K ; 
		@Pressure      	101325 	Pa;
		
		@EquivalenceRatio	2.0;
		@FuelMoles			CH4 1;
		@OxidizerMoles  	O2 0.21 
							N2 0.79 ;
}

