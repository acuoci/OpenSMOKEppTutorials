Dictionary PerfectlyStirredReactor
{
		@KineticsFolder			dummy;
		
		@Type					NonIsothermal-ConstantPressure;
		
		@InletStatus            inlet-mixture;
		
		@ResidenceTime			100 ms;

		@Volume                 50 cm3;
}

Dictionary inlet-mixture
{
		@Temperature   	1000.  	K ; 
		@Pressure      	101325 	Pa;
		
		@EquivalenceRatio 	1.0;
		@FuelMoles			NC7H16 1;
		@OxidizerMoles  	O2 0.21 
							N2 0.79 ;
}
