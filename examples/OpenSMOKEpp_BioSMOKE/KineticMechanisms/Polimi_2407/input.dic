Dictionary CHEMKIN_PreProcessor
{
		
	@Thermodynamics     		thermo.tdc;
	@Kinetics 			kinetics.gas;
	@Solid            		kinetics.solid;
	@Transport          		transport.tra;

	@Output				kinetics_compiled;

	@Comments 			CRECK-Signature;
}

Dictionary CRECK-Signature
{
	@Author 			CRECK Modeling Group;
	@Place  			creckmodeling.chem.polimi.it;
	@Comments			The kinetic scheme was created by CRECK Modeling Group;
}

