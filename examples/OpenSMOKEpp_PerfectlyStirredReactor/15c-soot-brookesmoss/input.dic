Dictionary PerfectlyStirredReactor
{
        @KineticsPreProcessor   POLIMI_PRF_PAH_LT_1412;

        @Type                   NonIsothermal-ConstantPressure;

        @InletStatus            inlet-mixture;

        @ResidenceTime          1 s;

        @Volume                 100 cm3;

        @MOM                    BrookesMoss;
}

Dictionary inlet-mixture
{
                @Temperature    1200.   K ;
                @Pressure       2.      atm ;

                @EquivalenceRatio       5.;
                @FuelMoles                      C3H6 1.;
                @OxidizerMoles          O2 21 N2 79;
}


Dictionary POLIMI_PRF_PAH_LT_1412
{
	@Kinetics               ../../../kinetic-mechanisms/POLIMI_1412/Kinetics/POLIMI_PRF_PAH_LT_1412.CKI;
	@Thermodynamics ../../../kinetic-mechanisms/POLIMI_1412/Thermodynamics/POLIMI_TOT_NOX_1412.CKT;
       	@Output                 kinetics;
}


Dictionary BrookesMoss
{
        @BrookesMoss                    true;

        @Precursors                     C10H8;
        @SurfaceGrowthSpecies           C2H2;
        @GasClosureDummySpecies         CSOOT;

        @NucleationModel                BrookesMoss;
        @SurfaceGrowthModel             1;
        @OxidationModel                 1;
        @CoagulationModel               1;
        @ThermophoreticModel            0;

        @GasConsumption                 true;

        @SootParticleDiameter           1 nm;
        @SootParticleMolecularWeight    144 kg/kmol;

        @Calpha  54 1/s;
        @Talpha  21000 K;
        @Cbeta   1.;
        @Cgamma  11700 kg*m/kmol/s;
        @Tgamma  12100 K;
        @Comega  105.8125 kg*m/kmol/sqrt(K)/s;
        @EtaColl 0.04;
        @Coxid   0.015;
        @NucleationExponent     1;
        @SurfaceGrowthExponent1 1;
        @SurfaceGrowthExponent2 1;
}

