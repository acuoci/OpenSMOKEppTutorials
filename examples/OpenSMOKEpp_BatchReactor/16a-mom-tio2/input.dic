Dictionary BatchReactor
{
		@KineticsPreProcessor	CRECK_2003_HT_TTIP;
		
		@Type			NonIsothermal-ConstantPressure;
		@MOM			MetalOxide;
		
		@InitialStatus          initial-mixture;
		
		@EndTime		0.01 s;
}

Dictionary CRECK_2003_HT_TTIP
{
		@Kinetics	../../../kinetic-mechanisms/CRECK_2003/HT_TTIP/CRECK_2003_TOT_HT_TTIP.chem;
		@Thermodynamics	../../../kinetic-mechanisms/CRECK_2003/HT_TTIP/CRECK_2003_TOT_HT_TTIP.thermo;
		@Transport	../../../kinetic-mechanisms/CRECK_2003/HT_TTIP/CRECK_2003_TOT_HT_TTIP.trans;
		@Output		kinetics;
}

Dictionary initial-mixture
{
	@MassFractions          C12H28O4TI      0.05
				H2		0.05
				O2		0.20
				N2		0.70;

	@Temperature   	1000.   K ; 
	@Pressure      	1       atm ;
}

Dictionary MetalOxide
{
        @MetalOxide                     true;

        @NucleationModel                1;      //          Nucleation model: 0=off, 1=on (default: 1)
        @SinteringModel                 1;      //          Sintering growth model: 0=off, 1=on (default: 1)
        @CondensationModel              1;      //          Condensation model: 0=off, 1=on (default: 1)
        @CoagulationModel               1;      //          Coagulation model: 0=off, 1=on (default: 1)
        @ThermophoreticModel            0;      //          Thermophoretic model: 0=off, 1=on (default: 1)

        @Precursor                      H4O4TI;         // Species to be assumed as precursor
        @GasClosureDummySpecies         TIO2RU;         // Gas closure dummy species (to ensure conservation of mass)
        @GasConsumption                 true;           // Consumption of gaseous species is accounted for (default: true)
	@GasStoichiometry           	H4O4TI:-1,H2O:2;

        // Sintering parameters
        // (Bruesser, 2011) [7.44e16 1/s/K/m^4, 1., 31000.]
        // (Seto, 1995) [9.75e15 1/s/K/m^4, 1., 31000.]
        // (Eggersdorf, 2012) [9.11e17 1/s/K/m^4, 1., 31000.]
        @As                             7.44e16 s,K,m;
        @ns                             1.0;
        @Ts                             31000. K;
        @SinteringDeferred              false;          // Deferred sintering contribution
        @SinteringDpMinimum             2e-9 m;         // Minimum diameter to apply sintering (regularization)
        @SinteringTauMinimum            1e-8 s;         // Minimum sintering time acceptable (regularization)
        @SinteringKMaximum              1e5 1/s;        // Maximum sintering rate acceptable (regularization)

//      @RadiativeHeatTransfer          true;           //      Radiative heat transfer (default: true)
        @SchmidtNumber                  50;             //      Schmidt number (default: 50)

//      @epsNucleation                  2.5;    //      Collision enhancement factor for nucleation (default: 2.5)
//      @epsCondensation                1.3;    //      Collision enhancement factor for condensation (default: 1.3)
//      @epsCoagulation                 2.2;    //      Collision enhancement factor for coagulation (default: 2.2)

        @DebugMode                      false;
}


