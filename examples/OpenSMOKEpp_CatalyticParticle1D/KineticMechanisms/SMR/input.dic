Dictionary CHEMKIN_PreProcessor
{
		@Thermodynamics SMR_Froment.CKT;
		@Transport	SMR_Froment.TRC;
		@Kinetics 	SMR_Froment.CKI;

		@TransportFittingCoefficients	true;
		@CheckThermodynamics		true;
		@ReactionTables			true;
		
		@Output		kinetics;
}

