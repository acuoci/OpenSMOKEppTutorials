Dictionary PlugFlowReactor
{
		@KineticsPreProcessor	POLIMI_H2CO_NOX_1412;
		
		@Type					NonIsothermal;
		
		@InletStatus          	inlet-mixture;
		
		@Length					10 cm;
		
		@ConstantPressure		false;
        @PressureProfile        P-Profile;
		
		@Velocity				1 m/s;

        @Options                output-options;
}

Dictionary output-options
{
        @OutputFolder           Output-adiabatic-pressure-profile;
        @StepsFile              1;
        @StepsVideo             1;
}

Dictionary POLIMI_H2CO_NOX_1412
{
		@Kinetics		../../../kinetic-mechanisms/POLIMI_1412/Kinetics/POLIMI_H2CO_NOX_1412.CKI;
		@Thermodynamics	../../../kinetic-mechanisms/POLIMI_1412/Thermodynamics/POLIMI_TOT_NOX_1412.CKT;
		@Output			kinetics;
}

Dictionary inlet-mixture
{
		@Temperature   	1000.  	K ; 
		@Pressure      	101325 	Pa;
		@Moles			H2 2 
						O2 1 
						N2 3.76 ;
}

Dictionary P-Profile
{	
		@XVariable length;
		@YVariable pressure;
		
		@XUnits cm;
		@YUnits Pa;
		
		@Profile
		0    101325
		5    111325
		7    121325
		10   131325;		
}

