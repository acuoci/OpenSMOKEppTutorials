Dictionary UnsteadyPlugFlowReactor
{
	@Type				BurnerStabilized;
	@KineticsPreProcessor		POLIMI_H2CO_NOX_1412;
	
	@InletStream 			inlet-stream;
	@OutletStream			outlet-stream;
	
	@InletVelocity			1 m/s;
	
	@Grid				grid;
	
	@Output				Output;
	
	@FixedTemperatureProfile 	T-Profile;

	@UseDaeSolver			true;
	@UseNlsSolver			false;

	@InternalDiameter		10 mm;

	@DaeParameters			dae-parameters;

	@TimeTotal			2 s;
	//@TimeInterval			0.02 s;
	@TimeList			0.01 0.02 0.05 0.1 0.2 2 s;

	@DepositionVelocity		10 m/s;

	//@DepositedSpecies		NO NO2 N2O ;
	@BatchSpecies			NO  ;
}

Dictionary dae-parameters
{
	@DaeSolver				OpenSMOKE++;
	@Jacobian				TridiagonalBlock;
	
	@RelativeTolerance		1e-6;
	@AbsoluteTolerance		1e-10;
	@MeanResidualThreshold		1e-64;
	@VerbosityLevel			1;
}

Dictionary POLIMI_H2CO_NOX_1412
{
		@Kinetics		../../../kinetic-mechanisms/POLIMI_1412/Kinetics/POLIMI_H2CO_NOX_1412.CKI;
		@Thermodynamics		../../../kinetic-mechanisms/POLIMI_1412/Thermodynamics/POLIMI_TOT_NOX_1412.CKT;
		@Output			kinetics;
}

Dictionary inlet-stream
{
		@Temperature   	1000.  	K ; 
		@Pressure      	101325 	Pa;
		@Moles			H2 2 
					O2 1 
					N2 3.76 
					NO 0.01;
}

Dictionary outlet-stream
{
		@Temperature   	1000.  	K ; 
		@Pressure      	101325 	Pa;
		@Moles			N2 1 
					NO 0.00148;
}

Dictionary grid
{
	@Length				0.1 cm;
	@InitialPoints			600;
	@Type				equispaced;
	
	@MaxPoints		30;
	@MaxAdaptivePoints	15;
	@GradientCoefficient	0.05;
	@CurvatureCoefficient	0.5;
}

Dictionary T-Profile
{	
	@XVariable length;
	@YVariable temperature;
		
	@XUnits cm;
	@YUnits K;
		
	@Profile
	0       1000.
	0.1	1000.;
//   	10	1000.;
}

