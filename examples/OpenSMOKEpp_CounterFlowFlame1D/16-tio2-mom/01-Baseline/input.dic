Dictionary CounterFlowFlame1D
{
	@Type					CounterFlowDiffusion;
	@KineticsPreProcessor	CRECK_2003_HT_TTIP;
	
	@FuelStream 			fuel-stream;
	@OxidizerStream			oxidizer-stream;
	
	// Strain rate: 50 1/s
	@FuelVelocity			55.59 cm/s;
	@OxidizerVelocity		18.75 cm/s;

	@Soret				true;
	
	@Grid				grid;
	
	@Output				Output;
	
	@InitialTemperatureProfile 		T-Profile;
	@EigenValueStartingGuess		-100 kg/m3/s2;
	
	@InitialProfiles			linear;
	@PeakPosition				7 mm;
	@MixingZoneWidth			3 mm;

	@Radiation					false;
	
	@UseDaeSolver				true;
	@UseNlsSolver				false;
}

Dictionary CRECK_2003_HT_TTIP
{
		@Kinetics		../../../../kinetic-mechanisms/CRECK_2003/HT_TTIP/CRECK_2003_TOT_HT_TTIP.chem;
		@Thermodynamics	../../../../kinetic-mechanisms/CRECK_2003/HT_TTIP/CRECK_2003_TOT_HT_TTIP.thermo;
		@Transport		../../../../kinetic-mechanisms/CRECK_2003/HT_TTIP/CRECK_2003_TOT_HT_TTIP.trans;
		@Output			kinetics;
}

Dictionary fuel-stream
{
	@MassFractions		C12H28O4TI 	0.0630 
						AR			0.2910
						H2			0.6460;
						
	@Temperature		380 K;
	@Pressure			1 atm;
}

Dictionary oxidizer-stream
{
	@MoleFractions	O2 0.21
					N2 0.79;
					
	@Temperature	412 K;
	@Pressure		1 atm;
}

Dictionary grid
{
	@Length				15 mm;
	@InitialPoints		15;
	@Type				equispaced;
	
	@MaxPoints				200;
	@MaxAdaptivePoints		10;
	@GradientCoefficient	0.05;
	@CurvatureCoefficient	0.5;
}

Dictionary T-Profile
{	
	@XVariable length;
	@YVariable temperature;
		
	@XUnits mm;
	@YUnits K;
		
	@Profile
	0	380
	2	380
	6	2200
	10	2200
	13	412
	15	412;
}

Dictionary dae-parameters
{
	@DaeSolver				OpenSMOKE++;
	@RelativeTolerance		1e-6;
	@AbsoluteTolerance		1e-10;
}



